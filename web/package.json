{
  "name": "miproxy-panel-web",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "vue-tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "test:unit": "node --test tests/unit/*.test.mjs",
    "test:browser": "node tests/browser/core-dialog.smoke.mjs && node tests/browser/discovery-ui.smoke.mjs && node tests/browser/runtime-ui.smoke.mjs && node tests/browser/unified-rules.smoke.mjs && node tests/browser/access-settings.smoke.mjs"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.13.1",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "@lucide/vue": "^1.78.0",
    "element-plus": "^2.14.8",
    "vue": "^3.5.46",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.7",
    "typescript": "~6.0.3",
    "vite": "^8.3.8",
    "vue-tsc": "^3.2.0"
  }
}
